# ─── CORE APPLICATION DATABASE ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── SECURITY ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CELERY / REDIS ───────────────────────────────────────────────────────
CELERY_BROKER_URL=rediss://default:password@host:6379/0
CELERY_RESULT_BACKEND=rediss://default:password@host:6379/0

# ─── THIRD-PARTY API KEYS ─────────────────────────────────────────────────
GROQ_API_KEY=
HF_TOKEN=
EXECUTION_MODE=distributed

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated, exact match, no trailing slashes.
ALLOWED_ORIGINS=http://localhost:3000

# ─── PUBLIC URLS ───────────────────────────────────────────────────────────
PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# ─── VRAM CACHE ─────────────────────────────────────────────────────────────
MAX_CACHED_BASE_MODELS=3

# ─── SMTP (transactional emails: welcome, login notification, password reset code) ──
# Leave these unset to disable email sending entirely — the app degrades
# gracefully (logs a warning, skips the send) rather than failing signup,
# login, or password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ─── VERIFALIA (email deliverability check on signup) ─────────────────────
# Leave unset to disable — signup then skips the deliverability check
# entirely (fails open) rather than blocking registration.
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=
