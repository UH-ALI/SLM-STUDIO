# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ─── POSTGRES (consumed by the db service in docker-compose.yml) ───────────
POSTGRES_USER=slm_user
POSTGRES_PASSWORD=change_me_to_a_real_password
POSTGRES_DB=slm_db

# ─── APP DATABASE CONNECTION ─────────────────────────────────────────────────
# Must reference the same POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
# Host is "db" because that's the service name on the docker compose network.
DATABASE_URL=postgresql://slm_user:change_me_to_a_real_password@db:5432/slm_db

# ─── AUTH / JWT ───────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CELERY (Redis broker + result backend) ──────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── THIRD-PARTY API KEYS ─────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# ─── EXECUTION MODE ───────────────────────────────────────────────────────────
# "distributed" = API dispatches to Celery worker (use this with docker-compose)
# "local"       = API runs ingestion/training inline (single-process dev only)
EXECUTION_MODE=distributed

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000
