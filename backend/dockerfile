FROM python:3.12-slim

# -----------------------------------------------------------------------------
# SYSTEM LIBRARIES
# build-essential + gcc + g++ → KEPT permanently — Triton compiles CUDA kernels
#                               at runtime during fine-tuning and needs gcc.
# Never remove these after pip install.
# libpq-dev                   → psycopg2-binary (PostgreSQL driver)
# libgl1                      → PyMuPDF (PDF reading) — renamed from libgl1-mesa-glx
#                               in Debian trixie (python:3.12-slim base)
# libglib2.0-0                → chromadb / hnswlib (vector store C++ bindings)
# libgomp1                    → PyTorch OpenMP (parallel CPU tensor operations)
# curl                        → Docker healthcheck command
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv — fast Python package installer
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy requirements FIRST — Docker caches this layer.
COPY requirements.txt .

# Install all Python dependencies using uv with BuildKit cache
# Added UV_CACHE_DIR explicit assignment to guarantee target accuracy
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_CACHE_DIR=/root/.cache/uv uv pip install --link-mode=copy --system -r requirements.txt

# -----------------------------------------------------------------------------
# NON-ROOT USER
# UID/GID default to 1000 to match the default WSL/Ubuntu host user, since
# docker-compose bind-mounts ./backend:/app and ~/.cache/huggingface at runtime —
# the container user needs a UID matching the host file owner or writes will
# fail with permission errors. Override at build time if your host user differs:
#   docker compose build --build-arg UID=$(id -u) --build-arg GID=$(id -g)
# -----------------------------------------------------------------------------
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} appuser \
    && useradd -m -u ${UID} -g ${GID} -s /bin/bash appuser

# Triton (unsloth's JIT CUDA kernel compiler) and HF both cache under $HOME
ENV HOME=/home/appuser
ENV HF_HOME=/home/appuser/.cache/huggingface

# Copy source code AFTER installing dependencies
COPY --chown=appuser:appuser . .

# Pre-create data directories your app writes to at runtime, owned by appuser
RUN mkdir -p data/raw data/processed data/vector_stores data/adapters \
    && chown -R appuser:appuser /app

USER appuser

# Default command — API server.
# The worker service in docker-compose.yml overrides this with the celery command.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]