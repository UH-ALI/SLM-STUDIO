# Only needed if you run the frontend directly with `npm run dev` instead of
# docker-compose (docker-compose already bakes this in as a build arg in
# docker-compose.yml, so you don't need this file for the dockerized setup).
#
# Copy this to frontend/.env.local and adjust if your API isn't on localhost:8000.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
